###### Kode Program Deteksi Video #######

!pip install ultralytics 
from ultralytics import YOLO
import cv2

# input model
model = YOLO("/content/drive/MyDrive/best.pt")

# input video
cap = cv2.VideoCapture("/content/drive/MyDrive/")

width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
fps = int(cap.get(cv2.CAP_PROP_FPS))

out = cv2.VideoWriter(
    "/content/output.mp4",
    cv2.VideoWriter_fourcc(*'mp4v'),
    fps,
    (width, height)
)

# pengaturan warna tiap kelas
class_colors = {
    'igneous_diorite': (139, 0, 0),        # Biru tua
    'sedimentary_coal': (200, 220, 255),   # Biru muda
    'metamorphic_marble': (255, 200, 100)  # Cream
}

while cap.isOpened():

    ret, frame = cap.read()

    if not ret:
        break

    # tracking
    results = model.track(
        frame,
        persist=True,
        tracker="botsort.yaml",
        conf=0.25,
        verbose=False
    )

    result = results[0]

    # gambar bounding box
    if result.boxes.id is not None:

        boxes = result.boxes
        ids = boxes.id.cpu().numpy()
        classes = boxes.cls.cpu().numpy()

        for box, obj_id, cls in zip(boxes, ids, classes):

            cls_id = int(cls)
            class_name = model.names[cls_id].lower()

            x1, y1, x2, y2 = map(int, box.xyxy[0])
            conf = float(box.conf[0])

            # warna bounding box sesuai kelas
            color = class_colors.get(class_name, (0, 255, 0))

            # bounding box
            cv2.rectangle(
                frame,
                (x1, y1),
                (x2, y2),
                color,
                3
            )

           
            # pengaturan label
           
            label = f"{class_name} {conf:.2f}"

            # warna teks label
            if class_name in ["sedimentary_coal", "metamorphic_marble"]:
                font_color = (0, 0, 0)  # Hitam
            else:
                font_color = (255, 255, 255)  # Putih

            (w, h), _ = cv2.getTextSize(
                label,
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                2
            )

            # background label
            cv2.rectangle(
                frame,
                (x1, y1 - h - 10),
                (x1 + w, y1),
                color,
                -1
            )

            # teks label
            cv2.putText(
                frame,
                label,
                (x1, y1 - 5),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                font_color,
                2
            )

  
    # total deteksi perframe

    current_total = len(result.boxes)

    cv2.putText(
        frame,
        f"Total Terdeteksi: {current_total}",
        (10, 30),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.8,
        (0, 0, 255),  # Merah
        2
    )

    out.write(frame)

cap.release()
out.release()

print("\nVideo tersimpan di /content/output.mp4")


